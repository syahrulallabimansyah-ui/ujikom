# ══════════════════════════════════════════════════════════
# AKSA NOVA — Security & Server Hardening (.htaccess)
# ══════════════════════════════════════════════════════════

# 1. Nonaktifkan penjelajahan direktori (Directory Browsing)
Options -Indexes

# 2. Blokir akses langsung ke berkas sensitif (.sql, .env, .git, .md, .log, .py, .sh)
<FilesMatch "\.(sql|env|ini|log|bak|git|py|sh|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Lindungi direktori database dan scripts
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|scripts|cache)/.*$ - [F,L]
</IfModule>

# 4. Header Keamanan Modern (Security Headers)
<IfModule mod_headers.c>
    # Cegah MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Cegah clickjacking (hanya izinkan dalam frame yang sama)
    Header set X-Frame-Options "SAMEORIGIN"
    # Aktifkan proteksi XSS peramban
    Header set X-XSS-Protection "1; mode=block"
    # Batasi pengiriman informasi referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
