@startuml 04_activity_persetujuan_pengajuan_admin
skinparam activity {
    BackgroundColor #FFF4C2
    BorderColor #6B5A1E
    DiamondBackgroundColor #FFE9A3
    DiamondBorderColor #C0282D
}
skinparam ArrowColor #6B5A1E

title Activity Diagram 04 — Persetujuan Tiket Pengajuan Peminjaman\n<i>File: pengajuan_buku.php</i>

|#DCFCE7|Pustakawan (Admin)|
|#F1F5F9|Sistem AKSA NOVA|

|Pustakawan (Admin)|
start
:Membuka menu Pengajuan Peminjaman;

|Sistem AKSA NOVA|
:Mengambil daftar tiket berstatus 'pending';
:Menampilkan data peminjam, buku, jumlah, dan jadwal ambil;

|Pustakawan (Admin)|
:Memeriksa ketersediaan buku fisik di rak;
if (Menyetujui Pengajuan?) then (<color:green>Ya</color>)
    :Klik tombol "Setujui";
    |Sistem AKSA NOVA|
    :Kurangi stok fisik buku di tabel buku;
    :Catat data ke tabel peminjaman\n(tgl_pinjam=CURRENT_DATE, batas_kembali=7 hari ke depan);
    :Ubah status tiket di pengajuan_peminjaman menjadi 'disetujui';
    :Perbarui antarmuka daftar pengajuan;
    |Pustakawan (Admin)|
    :Menyerahkan buku fisik saat anggota tiba;
    stop
else (<color:red>Tidak (Tolak)</color>)
    |Pustakawan (Admin)|
    :Klik tombol "Tolak" & tulis alasan;
    |Sistem AKSA NOVA|
    :Ubah status tiket di pengajuan_peminjaman menjadi 'ditolak';
    :Perbarui tampilan status tiket;
    |Pustakawan (Admin)|
    :Proses penolakan selesai;
    stop
endif
@enduml
