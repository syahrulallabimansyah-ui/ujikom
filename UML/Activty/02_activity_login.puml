@startuml 02_activity_login
skinparam activity {
    BackgroundColor #FFF4C2
    BorderColor #6B5A1E
    DiamondBackgroundColor #FFE9A3
    DiamondBorderColor #C0282D
}
skinparam ArrowColor #6B5A1E

title Activity Diagram 02 — Login Pengguna & Pengalihan Hak Akses\n<i>File: sign_in.php</i>

|#DBEAFE|Pengguna (User)|
|#F1F5F9|Sistem AKSA NOVA|

|Pengguna (User)|
start
:Membuka halaman login;

|Sistem AKSA NOVA|
:Menampilkan form login & generate CSRF token;

|Pengguna (User)|
:Memasukkan username/email dan kata sandi;
:Klik tombol "Masuk";

|Sistem AKSA NOVA|
:Verifikasi token CSRF;
if (CSRF Valid?) then (<color:green>Ya</color>)
    :Query tabel users berdasarkan username/email/no_anggota;
    if (Akun Ditemukan & Status Approved?) then (<color:green>Ya</color>)
        :Verifikasi kecocokan hash password;
        if (Password Cocok?) then (<color:green>Ya</color>)
            :Regenerasi session ID;
            :Simpan user_id, role, dan nama ke $_SESSION;
            if (Role == 'admin'?) then (<color:green>Ya</color>)
                :Redirect ke dashboard.php (Admin);
                |Pengguna (User)|
                :Mengakses antarmuka Dashboard Pustakawan;
                stop
            else (<color:red>Tidak (Member)</color>)
                |Sistem AKSA NOVA|
                :Redirect ke beranda.php (Anggota);
                |Pengguna (User)|
                :Mengakses antarmuka Beranda Anggota;
                stop
            endif
        else (<color:red>Tidak</color>)
            |Sistem AKSA NOVA|
            :Tampilkan pesan kesalahan password salah;
            |Pengguna (User)|
            :Mencoba login kembali;
            stop
        endif
    else (<color:red>Tidak</color>)
        |Sistem AKSA NOVA|
        :Tampilkan pesan akun tidak ditemukan / belum disetujui;
        |Pengguna (User)|
        :Memeriksa kembali identitas akun;
        stop
    endif
else (<color:red>Tidak</color>)
    |Sistem AKSA NOVA|
    :Tampilkan notifikasi token sesi kedaluwarsa;
    |Pengguna (User)|
    :Memuat ulang formulir login;
    stop
endif
@enduml
