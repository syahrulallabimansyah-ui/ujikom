@startuml 07_activity_tambah_buku_isbn
skinparam activity {
    BackgroundColor #FFF4C2
    BorderColor #6B5A1E
    DiamondBackgroundColor #FFE9A3
    DiamondBorderColor #C0282D
}
skinparam ArrowColor #6B5A1E

title Activity Diagram 07 — Penambahan Buku via Pemindaian ISBN\n<i>File: daftar_buku.php & cari_isbn.php</i>

|#DCFCE7|Pustakawan (Admin)|
|#F1F5F9|Sistem AKSA NOVA|

|Pustakawan (Admin)|
start
:Membuka menu Manajemen Buku & klik "Tambah Buku";
:Input nomor ISBN buku & klik tombol "Cari ISBN";

|Sistem AKSA NOVA|
:Kirim request ke Google Books API;
if (Metadata Ditemukan di Google Books?) then (<color:green>Ya</color>)
    :Ekstrak Judul, Penulis, Penerbit, Tahun, dan Cover;
else (<color:red>Tidak</color>)
    :Kirim request fallback ke Open Library API;
    if (Metadata Ditemukan di Open Library?) then (<color:green>Ya</color>)
        :Ekstrak metadata buku;
    else (<color:red>Tidak</color>)
        :Tampilkan pemberitahuan metadata ISBN tidak ditemukan;
    endif
endif

:Isi otomatis form HANYA pada kolom yang kosong\n(Tanpa menimpa isian manual yang sudah ada);

|Pustakawan (Admin)|
:Memeriksa kelengkapan data hasil autofill;
:Mengisi jumlah stok fisik, kategori genre, dan kode rak penyimpanan;
:Klik tombol "Simpan Buku";

|Sistem AKSA NOVA|
:Validasi CSRF & simpan gambar sampul lokal;
:Insert data koleksi ke tabel buku;
:Tampilkan konfirmasi buku berhasil ditambahkan;

|Pustakawan (Admin)|
:Buku siap dipinjamkan di sirkulasi;
stop
@enduml
