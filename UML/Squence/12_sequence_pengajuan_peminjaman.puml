@startuml 12_sequence_pengajuan_peminjaman
autonumber "1:"
skinparam sequence {
    ArrowColor #1F4E79
    ActorBorderColor #2563EB
    ActorBackgroundColor #DBEAFE
    LifeLineBorderColor #1F4E79
    LifeLineBackgroundColor #9CC3E6
    ParticipantBorderColor #1F4E79
    ParticipantBackgroundColor #E2E8F0
}

title 12. Sequence Diagram — Pengajuan Peminjaman Buku Daring\n<i>File: pengajuan_peminjaman.php</i>

actor "Anggota\n(Member)" as Member
boundary "Form Pengajuan\n(pengajuan_peminjaman.php)" as Boundary
control "PengajuanController\n(pengajuan_peminjaman.php)" as Control
entity "Tabel buku" as BukuEntity
entity "Tabel pengajuan_peminjaman" as PengajuanEntity

activate Member
Member -> Boundary: Akses form peminjaman buku terpilih
activate Boundary
Boundary -> Control: getDetailBuku(buku_id)
activate Control
Control -> BukuEntity: SELECT id, judul, stok FROM buku WHERE id=?
activate BukuEntity
BukuEntity --> Control: Data stok buku
deactivate BukuEntity
Control --> Boundary: Tampilkan kuota peminjaman (1 - 40 eksemplar)
deactivate Control
Boundary --> Member: Tampilkan form (Pilihan Jumlah & Waktu Ambil)
deactivate Boundary

Member -> Boundary: Masukkan jumlah (1-40) & opsi ambil (POST tanpa tanggal pinjam)
activate Boundary
Boundary -> Control: submitPengajuan(buku_id, total_buku, waktu_ambil, csrf_token)
activate Control
Control -> Control: csrf_verify()
Control -> Control: Validasi kuota (total_buku >= 1 && total_buku <= 40)
Control -> PengajuanEntity: INSERT INTO pengajuan_peminjaman (buku_id, user_id, jumlah, status='pending', catatan)
activate PengajuanEntity
PengajuanEntity --> Control: ID Pengajuan berhasil disimpan
deactivate PengajuanEntity

Control --> Boundary: Set Flash Message ("Pengajuan berhasil dikirim")
deactivate Control
Boundary --> Member: Tampilkan pesan konfirmasi antrean peminjaman
deactivate Boundary
deactivate Member
@enduml
