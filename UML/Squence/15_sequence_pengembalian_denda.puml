@startuml 15_sequence_pengembalian_denda
autonumber "1:"
skinparam sequence {
    ArrowColor #1F4E79
    ActorBorderColor #16A34A
    ActorBackgroundColor #DCFCE7
    LifeLineBorderColor #1F4E79
    LifeLineBackgroundColor #9CC3E6
    ParticipantBorderColor #1F4E79
    ParticipantBackgroundColor #E2E8F0
}

title 15. Sequence Diagram — Pemrosesan Pengembalian Buku & Kalkulasi Denda\n<i>File: telah_dipinjam.php</i>

actor "Pustakawan\n(Admin)" as Admin
boundary "Halaman Telah Dipinjam\n(telah_dipinjam.php)" as Boundary
control "KembaliController\n(telah_dipinjam.php)" as Control
entity "Tabel peminjaman" as PinjamEntity
entity "Tabel buku" as BukuEntity
entity "Tabel pengaturan" as PengaturanEntity

activate Admin
Admin -> Boundary: Klik "Kembalikan Buku" pada baris pinjaman
activate Boundary
Boundary -> Control: prosesKembali(peminjaman_id, csrf_token)
activate Control
Control -> Control: csrf_verify()

Control -> PinjamEntity: SELECT buku_id, batas_kembali FROM peminjaman WHERE id=?
activate PinjamEntity
PinjamEntity --> Control: Data transaksi peminjaman
deactivate PinjamEntity

Control -> PengaturanEntity: SELECT nilai FROM pengaturan WHERE kunci='denda_per_hari'
activate PengaturanEntity
PengaturanEntity --> Control: Tarif denda (misal: 1500)
deactivate PengaturanEntity

Control -> Control: hitungSelisihHari(CURRENT_DATE, batas_kembali)
alt Melewati batas waktu (Terlambat >= 1 hari penuh)
    Control -> Control: denda = selisih_hari * tarif_per_hari
else Tepat waktu / terlambat < 24 jam
    Control -> Control: denda = 0
end

Control -> BukuEntity: UPDATE buku SET stok = stok + 1 WHERE id=?
activate BukuEntity
BukuEntity --> Control: Stok bertambah (+1)
deactivate BukuEntity

Control -> PinjamEntity: UPDATE peminjaman SET tgl_kembali=CURRENT_DATE, status='kembali', denda=?, denda_terbayar='0' WHERE id=?
activate PinjamEntity
PinjamEntity --> Control: Status diperbarui
deactivate PinjamEntity

Control --> Boundary: Redirect / Tampilkan ringkasan denda
deactivate Control
Boundary --> Admin: Tampilkan status sukses pengembalian & nominal denda
deactivate Boundary
deactivate Admin
@enduml
