@startuml 13_sequence_persetujuan_pengajuan
autonumber "1:"
skinparam sequence {
    ArrowColor #1F4E79
    ActorBorderColor #16A34A
    ActorBackgroundColor #DCFCE7
    LifeLineBorderColor #1F4E79
    LifeLineBackgroundColor #9CC3E6
    ParticipantBorderColor #1F4E79
    ParticipantBackgroundColor #E2E8F0
}

title 13. Sequence Diagram — Persetujuan Tiket Pengajuan Peminjaman\n<i>File: pengajuan_buku.php</i>

actor "Pustakawan\n(Admin)" as Admin
boundary "Halaman Pengajuan\n(pengajuan_buku.php)" as Boundary
control "ApprovalController\n(pengajuan_buku.php)" as Control
entity "Tabel pengajuan_peminjaman" as PengajuanEntity
entity "Tabel buku" as BukuEntity
entity "Tabel peminjaman" as PinjamEntity

activate Admin
Admin -> Boundary: Buka daftar tiket pengajuan masuk
activate Boundary
Boundary -> Control: getPengajuanList()
activate Control
Control -> PengajuanEntity: SELECT * FROM pengajuan_peminjaman WHERE status='pending'
activate PengajuanEntity
PengajuanEntity --> Control: Daftar pengajuan pending
deactivate PengajuanEntity
Control --> Boundary: Render tabel tiket pengajuan
deactivate Control
Boundary --> Admin: Tampilkan daftar antrean pengajuan
deactivate Boundary

Admin -> Boundary: Klik tombol "Setujui" / "Tolak"
activate Boundary
Boundary -> Control: prosesAksi(action, pengajuan_id, csrf_token)
activate Control
Control -> Control: csrf_verify()

alt Aksi = Tolak
    Control -> PengajuanEntity: UPDATE pengajuan_peminjaman SET status='ditolak' WHERE id=?
    activate PengajuanEntity
    PengajuanEntity --> Control: Update status sukses
    deactivate PengajuanEntity
    Control --> Boundary: Notifikasi: Pengajuan ditolak
else Aksi = Setujui
    Control -> BukuEntity: UPDATE buku SET stok = stok - jumlah WHERE id=? AND stok >= jumlah
    activate BukuEntity
    BukuEntity --> Control: Stok berhasil dikurangi
    deactivate BukuEntity
    
    Control -> PinjamEntity: INSERT INTO peminjaman (buku_id, user_id, tgl_pinjam=CURRENT_DATE, batas_kembali=?, status='dipinjam')
    activate PinjamEntity
    PinjamEntity --> Control: Transaksi peminjaman resmi dicatat
    deactivate PinjamEntity
    
    Control -> PengajuanEntity: UPDATE pengajuan_peminjaman SET status='disetujui' WHERE id=?
    activate PengajuanEntity
    PengajuanEntity --> Control: Status tiket diperbarui
    deactivate PengajuanEntity
    Control --> Boundary: Notifikasi: Peminjaman disetujui & tercatat
end
deactivate Control
Boundary --> Admin: Perbarui tabel sirkulasi secara asinkron
deactivate Boundary
deactivate Admin
@enduml
